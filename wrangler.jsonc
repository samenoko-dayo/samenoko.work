{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "samenoko.work",
    "compatibility_date": "2026-03-10",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },
    "route": {
        "pattern": "samenoko.work",
        "custom_domain": true
    }
}