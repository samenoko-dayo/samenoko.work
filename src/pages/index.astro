---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);

const posts = allPosts.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 3);
const latestPosts = posts.slice(0, 3);
const displayPosts = featuredPosts.length > 0 ? featuredPosts : latestPosts;

const allTags = [
    ...new Set(posts.flatMap((post) => post.data.tags ?? []).map((t) => t.tag)),
].sort((a, b) => a.localeCompare(b, "ja"));

const formatDate = (date: Date) =>
    date.toLocaleDateString("ja-JP", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    });
---

<Layout
    title="Home"
    description="技術メモ、制作記録、日常の気付きなどをまとめたブログです。"
>
    <section class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-10 md:py-16">
        <div
            class="hero overflow-hidden rounded-box border border-base-300 bg-base-200"
        >
            <div class="hero-content w-full px-6 py-10 md:px-10 md:py-16">
                <div class="max-w-3xl w-full">
                    <div class="mb-4">
                        <span class="badge badge-primary badge-outline"
                            >Personal Blog</span
                        >
                    </div>

                    <h1 class="text-4xl font-black leading-tight md:text-5xl">
                        プログラミング初学者が<br />
                        <span class="text-primary">適当に書いているブログ</span>
                    </h1>

                    <p class="mt-5 text-base-content/75 md:text-lg">
                        プログラミング初学者によるブログです。<br />
                        技術系から雑記まで書き殴っていきます。
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <a href="/blog" class="btn btn-primary"
                            >記事一覧を見る</a
                        >
                        <a href="/about" class="btn btn-outline">About</a>
                    </div>
                </div>
            </div>
        </div>

        <section class="grid gap-4 md:grid-cols-3">
            <div class="card border border-base-300 bg-base-100 shadow-sm">
                <div class="card-body">
                    <h2 class="card-title text-lg">技術メモ</h2>
                    <p class="text-sm text-base-content/70">
                        開発中に詰まったことや、あとで見返したい備忘録的なものを残します。
                    </p>
                </div>
            </div>

            <div class="card border border-base-300 bg-base-100 shadow-sm">
                <div class="card-body">
                    <h2 class="card-title text-lg">制作記録</h2>
                    <p class="text-sm text-base-content/70">
                        アプリやサイトなどの制作記録をまとめます。
                    </p>
                </div>
            </div>

            <div class="card border border-base-300 bg-base-100 shadow-sm">
                <div class="card-body">
                    <h2 class="card-title text-lg">日々のログ</h2>
                    <p class="text-sm text-base-content/70">
                        どうでもいい極めて個人的な記録です。
                    </p>
                </div>
            </div>
        </section>

        <section class="flex flex-col gap-5">
            <div class="flex items-end justify-between gap-4">
                <div>
                    <h2 class="text-2xl font-bold md:text-3xl">最新の記事</h2>
                    <p class="mt-1 text-sm text-base-content/70">
                        最近公開した記事や、まず読んでほしい記事です。
                    </p>
                </div>

                <a
                    href="/blog"
                    class="link link-hover text-sm font-medium text-primary"
                >
                    すべて見る
                </a>
            </div>

            {
                displayPosts.length > 0 ? (
                    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                        {displayPosts.map((post) => (
                            <article class="overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                                {post.data.heroImage && (
                                    <figure class="border-b border-base-300 bg-base-200">
                                        <Image
                                            src={post.data.heroImage}
                                            alt={post.data.title}
                                            class="h-48 w-full object-cover"
                                            inferSize
                                        />
                                    </figure>
                                )}

                                <div class="card-body">
                                    <div class="flex flex-wrap items-center gap-2 text-xs text-base-content/60">
                                        {post.data.tags?.[0] && (
                                            <span class="badge badge-outline">
                                                {post.data.tags[0].tag}
                                            </span>
                                        )}
                                        <span>
                                            {formatDate(post.data.pubDate)}
                                        </span>
                                    </div>

                                    <h3 class="card-title mt-2 text-lg leading-snug">
                                        <a
                                            href={`/blog/${post.id}/`}
                                            class="link-hover hover:text-primary"
                                        >
                                            {post.data.title}
                                        </a>
                                    </h3>

                                    <p class="text-sm text-base-content/75">
                                        {post.data.description}
                                    </p>

                                    <div class="card-actions mt-3 justify-end">
                                        <a
                                            href={`/blog/${post.id}/`}
                                            class="btn btn-sm btn-ghost"
                                        >
                                            読む
                                        </a>
                                    </div>
                                </div>
                            </article>
                        ))}
                    </div>
                ) : (
                    <div class="rounded-box border border-dashed border-base-300 bg-base-100 p-8 text-center">
                        <p class="text-base-content/70">
                            まだ記事がありません。
                        </p>
                    </div>
                )
            }
        </section>

        <section class="rounded-box border border-base-300 bg-base-100 p-6">
            <div
                class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
            >
                <div>
                    <h2 class="text-2xl font-bold">タグから探す</h2>
                    <p class="mt-1 text-sm text-base-content/70">
                        興味のあるテーマごとに記事をたどれます。
                    </p>
                </div>

                <a href="/tags" class="btn btn-outline btn-sm">タグ一覧へ</a>
            </div>

            <div class="mt-5 flex flex-wrap gap-2">
                {
                    allTags.length > 0 ? (
                        allTags.map((tag) => (
                            <a
                                href={`/tags/${encodeURIComponent(tag.toLowerCase())}/`}
                                class="badge badge-lg badge-outline transition hover:border-primary hover:text-primary"
                            >
                                {tag}
                            </a>
                        ))
                    ) : (
                        <span class="text-sm text-base-content/60">
                            タグはまだありません。
                        </span>
                    )
                }
            </div>
        </section>
    </section>
</Layout>
