---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const tagMap = new Map<string, number>();

for (const post of posts) {
    for (const tag of post.data.tags) {
        tagMap.set(tag.tag, (tagMap.get(tag.tag) ?? 0) + 1);
    }
}

const tags = [...tagMap.entries()]
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => a.name.localeCompare(b.name, "ja"));
---

<Layout title="Tags" description="ブログ内のタグ一覧です。">
    <section class="mx-auto max-w-6xl px-4 py-10 md:py-14">
        <header class="mb-10">
            <h1 class="text-4xl font-black md:text-5xl">Tags</h1>
            <p class="mt-3 text-base-content/70">記事をタグごとに探せます。</p>
        </header>

        {
            tags.length > 0 ? (
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    {tags.map((tag) => (
                        <a
                            href={`/tags/${encodeURIComponent(tag.name.toLowerCase())}/`}
                            class="card border border-base-300 bg-base-100 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
                        >
                            <div class="card-body">
                                <div class="flex items-center justify-between gap-3">
                                    <h2 class="card-title text-lg">
                                        {tag.name}
                                    </h2>
                                    <span class="badge badge-primary badge-outline">
                                        {tag.count}
                                    </span>
                                </div>
                                <p class="text-sm text-base-content/65">
                                    {tag.count} 件の記事
                                </p>
                            </div>
                        </a>
                    ))}
                </div>
            ) : (
                <div class="rounded-box border border-dashed border-base-300 bg-base-100 p-10 text-center">
                    <p class="text-base-content/70">タグはまだありません。</p>
                </div>
            )
        }
    </section>
</Layout>
