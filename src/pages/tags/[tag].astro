---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => !data.draft);

    const tagMap = new Map<string, string>();

    for (const post of posts) {
        for (const tag of post.data.tags) {
            const slug = tag.tag.toLowerCase();
            if (!tagMap.has(slug)) {
                tagMap.set(slug, tag.tag);
            }
        }
    }

    return [...tagMap.entries()].map(([tagSlug, tagName]) => ({
        params: { tag: tagSlug },
        props: { tagSlug, tagName },
    }));
}

const { tagSlug, tagName } = Astro.props;

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const posts = allPosts.filter((post) =>
    post.data.tags.some((tag) => tag.tag.toLowerCase() === tagSlug),
);

const formatDate = (date: Date) =>
    date.toLocaleDateString("ja-JP", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    });
---

<Layout
    title={`Tag: ${tagName}`}
    description={`「${tagName}」タグの記事一覧です。`}
>
    <section class="mx-auto max-w-6xl px-4 py-10 md:py-14">
        <header class="mb-10">
            <div class="flex flex-wrap items-center gap-3">
                <span class="badge badge-primary badge-outline badge-lg"
                    >{tagName}</span
                >
                <span class="text-sm text-base-content/60"
                    >{posts.length} 件の記事</span
                >
            </div>

            <h1 class="mt-4 text-4xl font-black md:text-5xl">
                {tagName}
            </h1>

            <p class="mt-3 text-base-content/70">
                「{tagName}」に関連する記事一覧です。
            </p>

            <div class="mt-5">
                <a href="/tags" class="btn btn-outline btn-sm">タグ一覧へ戻る</a
                >
            </div>
        </header>

        {
            posts.length > 0 ? (
                <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                    {posts.map((post) => (
                        <article class="card border border-base-300 bg-base-100 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                            <div class="card-body">
                                <div class="flex flex-wrap items-center gap-2 text-xs text-base-content/60">
                                    <span>{formatDate(post.data.pubDate)}</span>
                                </div>

                                <h2 class="card-title mt-2 text-lg leading-snug">
                                    <a
                                        href={`/blog/${post.id}/`}
                                        class="link-hover hover:text-primary"
                                    >
                                        {post.data.title}
                                    </a>
                                </h2>

                                <p class="text-sm text-base-content/75">
                                    {post.data.description}
                                </p>

                                <div class="mt-2 flex flex-wrap gap-1">
                                    {post.data.tags.map((tag) => (
                                        <a
                                            href={`/tags/${encodeURIComponent(tag.tag.toLowerCase())}/`}
                                            class:list={[
                                                "badge badge-sm",
                                                tag.tag.toLowerCase() === tagSlug
                                                    ? "badge-primary"
                                                    : "badge-ghost",
                                            ]}
                                        >
                                            {tag.tag}
                                        </a>
                                    ))}
                                </div>

                                <div class="card-actions mt-3 justify-end">
                                    <a
                                        href={`/blog/${post.id}/`}
                                        class="btn btn-sm btn-ghost"
                                    >
                                        読む →
                                    </a>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            ) : (
                <div class="rounded-box border border-dashed border-base-300 bg-base-100 p-10 text-center">
                    <p class="text-base-content/70">
                        このタグの記事はまだありません。
                    </p>
                </div>
            )
        }
    </section>
</Layout>
