---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const formatDate = (date: Date) =>
    date.toLocaleDateString("ja-JP", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    });
---

<Layout title="Blog" description="技術メモや制作記録などの記事一覧です。">
    <section class="mx-auto max-w-6xl px-4 py-10 md:py-14">
        <header class="mb-10">
            <h1 class="text-4xl font-black md:text-5xl">Blog</h1>
            <p class="mt-3 text-base-content/70">
                技術メモ、制作記録、Linuxログなどの記事一覧です。
            </p>
        </header>

        {
            posts.length > 0 ? (
                <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                    {posts.map((post) => (
                        <article class="overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                            {post.data.heroImage && (
                                <div class="flex h-48 items-center justify-center border-b border-base-300 bg-base-200 text-7xl">
                                    <span aria-label="ヒーロー絵文字">{post.data.heroImage}</span>
                                </div>
                            )}

                            <div class="card-body">
                                <div class="flex flex-wrap items-center gap-2 text-xs text-base-content/60">
                                    {post.data.tags?.[0] && (
                                        <span class="badge badge-outline">
                                            {post.data.tags[0].tag}
                                        </span>
                                    )}
                                    <span>{formatDate(post.data.pubDate)}</span>
                                </div>

                                <h2 class="card-title mt-2 text-lg leading-snug">
                                    <a
                                        href={`/blog/${post.id}/`}
                                        class="link-hover hover:text-primary"
                                    >
                                        {post.data.title}
                                    </a>
                                </h2>

                                <p class="text-sm text-base-content/75">
                                    {post.data.description}
                                </p>

                                {post.data.tags.length > 1 && (
                                    <div class="mt-2 flex flex-wrap gap-1">
                                        {post.data.tags
                                            .slice(1, 4)
                                            .map((tag) => (
                                                <span class="badge badge-ghost badge-sm">
                                                    {tag.tag}
                                                </span>
                                            ))}
                                    </div>
                                )}

                                <div class="card-actions mt-3 justify-end">
                                    <a
                                        href={`/blog/${post.id}/`}
                                        class="btn btn-sm btn-ghost"
                                    >
                                        読む →
                                    </a>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            ) : (
                <div class="rounded-box border border-dashed border-base-300 bg-base-100 p-10 text-center">
                    <p class="text-base-content/70">まだ記事がありません。</p>
                </div>
            )
        }
    </section>
</Layout>
